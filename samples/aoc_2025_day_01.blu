mod main

main: = || {
  text: = "TODO"

  count: i32 = 0
  pcount: i32 = 0
  dial: i32 = 50

  i: i32= 0
  while i < text {
    sign := if text[i] == "L" { -1 } else { 1 }

    i += 1

    n := text[i] - "0"

    i += 1

    while text[i] >= "0" and text[i] <= "9" {
      n *= 10
      n += text[i] - "0"
      i += 1
    }

    pcount += n / 100

    n %= 100

    was_on_zero := dial == 0
    dial += sign * n

    if dial < 0 {
      dial += 100
      pcount += !was_on_zero
    }

    if dial >= 100 {
      dial -= 100
      pcount += 1
    }

    if dial == 0 {
      count += 1
      if sign < 0 {
        pcount += 1
      }
    }

    while i < text {
      if text[i] == "L" or text[i] == "R" {
        break
      }

      i += 1
    }
  }

  #debug(count)
  #debug(pcount)
}
