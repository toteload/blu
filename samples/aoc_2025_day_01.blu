mod main

main: = ||: i32 {
  text: []u8 = "L68 L30 R48 L5 R60 L55 L1 L99 R14 L82 " // needs a space at the end

  count: i32 = 0
  pcount: i32 = 0
  dial: i32 = 50

  i: usize = 0
  while i < #len(text) {
    sign: i32 = if text[i] == u8"L" do -1 else 1

    i += 1

    n: i32 = 0

    while text[i] >= u8"0" and text[i] <= u8"9" {
      n *= 10
      n += cast(i32) text[i] - u8"0"
      i += 1
    }

    pcount += n / 100

    n %= 100

    was_on_zero: bool = dial == 0
    dial += sign * n

    if dial < 0 {
      dial += 100
      pcount += !was_on_zero
    }

    if dial >= 100 {
      dial -= 100
      pcount += 1
    }

    if dial == 0 {
      count += 1
      if sign < 0 {
        pcount += 1
      }
    }

    while i < #len(text) {
      if text[i] == u8"L" or text[i] == u8"R" {
        break
      }

      i += 1
    }
  }

  #debug(count) // should be 3
  #debug(pcount) // should be 6
}
