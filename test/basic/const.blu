main : (): i32 = || {
  comptime x := as(i32) {45 + 5} / 5
  a : i32 = 0
  b : i32 = one_or_two(false)
  c : i32 = one_or_two(true)
  comptime fac(x) - 3628800
}

fac : (i32): i32 = |n| {
  if n == 0 {
    1
  } else {
    n * fac(n-1)
  }
}

; if you call a function that has a comptime parameter, then the function gets instantiated/generated
; for the specific arguments.

one_or_two := |comptime toggle: bool|: i32 {
  if toggle { 1 } else { 2 } 
}
