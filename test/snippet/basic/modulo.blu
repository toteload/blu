mod main

main := ||: i32 {
  a := id_i32(11)
  p: i32 = a % 4
  #debug(p)

  d := id_i32(-4)
  q: i32 = a % d
  #debug(q)

  n := id_i32(-11)
  r: i32 = n % 4
  #debug(r)

  u := id_usize(11)
  v: usize = u % 4
  #debug(v)

  mut c := id_i32(100)
  c %= 30
  #debug(c)

  0
}

id_i32 := |x: i32|: i32 { x }
id_usize := |x: usize|: usize { x }
