mod main

CT : i64 = {
  mut i: i64 = 0
  mut n: i64 = 0
  while i < 4 {
    i += 1
    if i == 2 { n += cast(i64) continue }
    n += i
  }
  n
}

main := ||: i32 {
  mut i: i32 = 0
  mut n: i32 = 0
  while i < 4 {
    i += 1
    if i == 2 { n += cast(i32) continue }
    mut x: i32 = ::b { break ::b 1 }
    n += x + i
  }
  #debug(CT)
  #debug(n)
  0
}
