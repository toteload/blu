mod main

A : bool = true and false
B : bool = false or true
C : i32 = ::o { if true { break ::o if true and true do 3 else 4 }  20 }

main: () i32 = || {
  i: i32 = 0
  n: i32 = 0
  while i < 10 {
    i += 1
    if yes() and i > 3 {
      if no() or i == 7 { break }
      n += 1
    } else {
      n += 10
    }
  }
  #debug(i)
  #debug(n)
  #debug(A)
  #debug(B)
  #debug(C)
  #debug(true and yes())
  #debug(false and yes())
  #debug(true or no())
  #debug(false or no())
  0
}

yes := ||: bool true
no := ||: bool false
