mod main

SUM : i64 = {
  mut i: i64 = 0
  mut sum: i64 = 0
  while i < 10 {
    i += 1
    if i % 2 == 0 { continue }
    mut sq := i * i
    sum += sq
  }
  sum
}

FIRST : i64 = {
  mut i: i64 = 0
  ::outer while true {
    mut j: i64 = 0
    while j < 5 {
      j += 1
      if i * j == 12 { break ::outer }
    }
    i += 1
  }
  i
}

FOUND : i64 = ::f {
  mut i: i64 = 0
  while i < 100 {
    if i * i > 50 { break ::f i }
    i += 1
  }
  0
}

main := ||: i32 {
  #debug(SUM)
  #debug(FIRST)
  #debug(FOUND)
  0
}
