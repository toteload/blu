ArrayOfi32OrSomethingElse := |n: comptime uint|: type {
  if n < 10 {
    [n]i32
  } else {
    bool
  }
}

  |
  |
  v

ArrayOfi32_ := |n: uint|: typeid {
  if n < 10 {
    #typeid({ .array = .{ .base = #typeid(.int, .signed, 32), .size = n }})
  } else {
    #typeid({ .bool })
  }
}

